            <li>FCP_Slave_Apparel</li>
        </apparelTags>
        <techHediffsMoney>50~50</techHediffsMoney>
        <techHediffsTags>
            <li>Poor</li>
        </techHediffsTags>
        <techHediffsChance>0.15</techHediffsChance>
        <initialWillRange>0~1</initialWillRange>
        <initialResistanceRange>4~8</initialResistanceRange>
    </PawnKindDef>

